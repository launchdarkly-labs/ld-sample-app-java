# LaunchDarkly SDK Key
# Server-side SDK key from project nteixeira-ld-custom
LAUNCHDARKLY_SDK_KEY=your-sdk-key

# User identity (login prefills)
USER_EMAIL=your-email@example.com
USER_NAME=Your Name
USER_ROLE=admin

# Login prefill. Must be 1001, 2002, or 3003
TENANT_ID=1001

# Application version (semver: MAJOR.MINOR.PATCH)
APP_VERSION=4.18.0

# Git commit SHA for this build
GIT_SHA=abc1234

# Application deployment ring
DEPLOYMENT_RING=stable
