# LaunchDarkly SDK Key
# Server-side SDK key from project nteixeira-ld-custom
LAUNCHDARKLY_SDK_KEY=your-sdk-key

# User context key is the email; also stored as the email attribute
USER_EMAIL=your-email@example.com

# Display name for the user context
USER_NAME=Your Name

# User attribute used for targeting
USER_ROLE=admin

# Tenant context key
TENANT=acme
